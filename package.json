{
  "name": "7h-music-group-vinyl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "7H Music Group \u2014 Vinyl Production & Brokerage. Turnkey vinyl pressing quote configurator, client portal and admin order webhooks.",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:flow": "node scripts/flow.mjs",
    "test": "npm run typecheck && npm run test:serverless && npm run test:smoke && npm run test:flow",
    "test:serverless": "node scripts/serverless-check.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": "22.x"
  }
}
