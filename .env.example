# Local runtime
PORT=4173

# FX. USD is the base currency for every stored amount; these only drive what a
# visitor sees. Rates are fetched live (see server/rates.js) and cached for an hour.
FX_UGX_PER_USD=4360
# Never quote UGX below this, whatever the market does (defaults to FX_UGX_PER_USD).
# FX_UGX_FLOOR=4360
# FX_API_URL=https://api.frankfurter.dev/v1/latest?base=USD&symbols=EUR,GBP
# FX_UGX_API_URL=https://open.er-api.com/v6/latest/USD
# FX_CACHE_SECONDS=3600
# FX_STALE_SECONDS=21600

# Operations console access code (change this in production!)
ADMIN_PASSCODE=7HADMIN

# Secret used to sign admin session tokens (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Bearer token for the daily alert-retry cron (generate with: openssl rand -hex 24).
# Unset = the cron route is disabled (503), which is safe.
# CRON_SECRET=

# Where the data lives. Drivers are picked at boot in this order:
#   postgres (any of the URL vars below) → redis (Upstash/Vercel KV) → file
# With none set, the store is a JSON file under DATA_DIR — fine locally, NOT
# durable on Vercel, where /tmp is wiped on a cold start. See DEPLOYMENT.md §3.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# POSTGRES_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional: override where the file store and uploads live.
# DATA_DIR=
# UPLOAD_DIR=

# Business contact details (shown in the UI, WhatsApp links and alerts).
# CONTACT_EMAIL=7hmusicgroupug@gmail.com
# CONTACT_PHONE=+256 768 261 003
# CONTACT_WHATSAPP=256768261003

# Deposit collection accounts shown at checkout. Airtel / bank are left as
# "issued on your invoice" until those accounts are confirmed.
# MOMO_NUMBER=0768 261 003
# AIRTEL_NUMBER=0700 000 000
# BANK_ACCOUNT=Stanbic Bank · 9030000000000

# ---------------------------------------------------------------------------
# Notifications — real alerts on every order. All optional; each channel is
# independent and is ONLY used when its variables are present. With none set,
# the admin console keeps the honest "simulated" webhook log.
# See README.md → "Notifications" and DEPLOYMENT.md → "Notifications".
# ---------------------------------------------------------------------------

# 1) Slack (recommended, 2-minute setup): create an Incoming Webhook
#    https://api.slack.com/messaging/webhooks and paste the URL here.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# 2) Email via Resend (https://resend.com) — the API key alone is enough.
#    Recipient defaults to CONTACT_EMAIL; sender defaults to Resend's test
#    address, which can mail the account owner. Set NOTIFY_EMAIL_FROM to an
#    address on a verified domain for production use.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# NOTIFY_EMAIL_TO=7hmusicgroupug@gmail.com
# NOTIFY_EMAIL_FROM=7H Music Group <orders@7hmusicgroup.com>

# 3) Telegram (the fast rail — no business account, no template review):
#    message @BotFather → /newbot → copy the token; message your own bot once,
#    then read the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
#    Several chat ids are allowed, comma separated (a DM and a group, say).
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_CHAT_ID=768261003

# 4) WhatsApp Cloud API (Meta) — business number + recipient in E.164 format.
#    Needs a Meta app, business verification and an approved Utility template.
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=123456789012345
# NOTIFY_WHATSAPP_TO=256768261003

# 5) Generic webhook: one URL that receives a JSON POST for every channel
#    (slack/email/telegram/whatsapp). Use it for Zapier / Make / n8n / your bot.
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/7h-order-alerts

# 5) Pressing plants — one real rep inbox per plant. A production request is only
#    emailed once an admin has confirmed the 50% deposit; there is no setting that
#    releases an order earlier. The desk (NOTIFY_EMAIL_TO) is BCC'd as a record.
#    When a plant inbox equals NOTIFY_EMAIL_TO the BCC is skipped so the same
#    mailbox never gets two copies.
# PLANT_MOBINEKO_EMAIL=web@mobineko.com             # Mobineko (TW)
# PLANT_GREENLAKES_EMAIL=hi@greenlakespressing.com  # Green Lakes (LT)
# PLANT_SEABASS_EMAIL=orders@seabassvinyl.com       # Seabass Vinyl (UK)
# PLANT_DRDUB_EMAIL=info@drdub.com                  # Dr. Dub (AT)
# PLANT_GZMEDIA_EMAIL=gz@gzmedia.cz                 # GZ Media (CZ)
# PLANT_DEEPGROOVES_EMAIL=info@deepgrooves.eu       # Deepgrooves (NL)
# PLANT_ORDERS_EMAIL=orders@example.com   # catch-all if a plant has no address
# PLANT_AUTO_FORWARD=true                 # true = send the moment the deposit clears
#                                         # false = press "Forward" in /admin after it clears
# Where the desk forwards when a plant inbox points at 7H instead of the plant.
# Printed on the drop-ship slip as "Forward to", so the desk never has to look it up.
# PLANT_MOBINEKO_REP_EMAIL=web@mobineko.com
# PLANT_GREENLAKES_REP_EMAIL=hi@greenlakespressing.com
# PLANT_SEABASS_REP_EMAIL=orders@seabassvinyl.com
# PLANT_DRDUB_REP_EMAIL=info@drdub.com
# PLANT_GZMEDIA_REP_EMAIL=gz@gzmedia.cz
# PLANT_DEEPGROOVES_REP_EMAIL=info@deepgrooves.eu
# PLANT_WEBHOOK_URL=https://plant.example.com/orders
# PUBLIC_BASE_URL=https://thevinylplugsug.vercel.app

# 5b) The record shop — fans buying one copy. Prices and delivery fees live in
#     shared/shop.js; this only caps how many checkouts one IP can open a minute.
# SHOP_ORDERS_PER_MINUTE=12

# 6) WhatsApp template (Meta) — required for business-initiated messages.
#    Sample body to submit: see DEPLOYMENT.md → "WhatsApp template".
# WHATSAPP_TEMPLATE_NAME=new_vinyl_order
# WHATSAPP_TEMPLATE_LANG=en_US

# ---------------------------------------------------------------- database
# Where orders, shop stock and the alert log live. Without DATABASE_URL the app
# falls back to data/db.json, which is wiped on every Vercel cold start.
# DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Prefer Redis? Vercel KV and Upstash both inject these:
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx

# Lets Vercel's daily cron (vercel.json) retry failed alerts. Unset = route disabled.
# CRON_SECRET=replace-with-openssl-rand-hex-24

# ---------------------------------------------------------------- alerts
# Email (Resend). Without a key, email alerts stay simulated and the console says so.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTIFY_EMAIL_TO=7hmusicgroupug@gmail.com
# NOTIFY_EMAIL_FROM=7H Music Group <onboarding@resend.dev>
# WhatsApp Cloud API (Meta). Outside a 24h window this needs an approved template.
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_CHAT_ID=768261003
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=1029384756
# NOTIFY_WHATSAPP_TO=256768261003
# WHATSAPP_TEMPLATE_NAME=new_vinyl_order
# WHATSAPP_TEMPLATE_LANG=en_US
# Slack incoming webhook, or one automation endpoint for every channel.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFY_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
