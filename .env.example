# Local runtime
PORT=4173

# Indicative FX rate used for every USD → UGX conversion
FX_UGX_PER_USD=3750

# Operations console access code (change this in production!)
ADMIN_PASSCODE=7HADMIN

# Secret used to sign admin session tokens (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Optional: override where the JSON store and uploads live.
# On Vercel these default to /tmp (ephemeral) — see DEPLOYMENT.md.
# DATA_DIR=
# UPLOAD_DIR=

# ---------------------------------------------------------------------------
# Notifications — real alerts on every order. All optional; each channel is
# independent and is ONLY used when its variables are present. With none set,
# the admin console keeps the honest "simulated" webhook log.
# See README.md → "Notifications" and DEPLOYMENT.md → "Notifications".
# ---------------------------------------------------------------------------

# 1) Slack (recommended, 2-minute setup): create an Incoming Webhook
#    https://api.slack.com/messaging/webhooks and paste the URL here.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx

# 2) Email via Resend (https://resend.com) — needs an API key and both addresses.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# NOTIFY_EMAIL_TO=orders@7hmusic.group
# NOTIFY_EMAIL_FROM=7H Vinyl <orders@7hmusic.group>

# 3) WhatsApp Cloud API (Meta) — business number + recipient in E.164 format.
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=123456789012345
# NOTIFY_WHATSAPP_TO=2567XXXXXXXX

# 4) Generic webhook: one URL that receives a JSON POST for every channel
#    (slack/email/whatsapp). Use it for Zapier / Make / n8n / your own bot.
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/7h-order-alerts

# 5) Pressing-plant forwarding: enables the admin "Forward to plant" button.
# PLANT_WEBHOOK_URL=https://plant.example.com/orders
# PLANT_WEBHOOK_PLANT=Mobineko
# PUBLIC_BASE_URL=https://thevinylplugsug.vercel.app
